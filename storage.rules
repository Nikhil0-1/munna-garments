rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Product images: authenticated owners can upload/delete.
    // Anyone can read (public catalogue needs image access).
    match /product_images/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // All other paths: authenticated users only.
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
