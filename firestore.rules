rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: is the request from an authenticated user? ────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    // ── Helper: check if user is verified active Owner in /users/{uid} ─────────
    function isOwner() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }

    // ── 1. PUBLIC DIGITAL CATALOGUE & SHOWROOM ─────────────────────────────────
    // Public visitors (unauthenticated) can READ published catalogue items.
    // Strictly ONLY the verified shop owner can publish or modify catalogue data.
    match /publicCatalogue/{document=**} {
      allow read: if true;
      allow write: if isOwner();
    }

    // ── 2. PRIVATE SHOP DATA (Strictly Owner-Only) ─────────────────────────────
    // Sales, Sale Items, Purchases, Purchase Items, Customers, Suppliers,
    // Expenses, Payments, Ledgers, Inventory, Stock Movements, Invoices, Settings.
    match /privateShopData/{document=**} {
      allow read, write: if isOwner();
    }

    // ── 3. USER PROFILES ───────────────────────────────────────────────────────
    // A user may only read/write their own profile document.
    match /users/{uid} {
      allow read: if isAuthenticated() && request.auth.uid == uid;
      allow write: if isAuthenticated() && request.auth.uid == uid;
    }

    // ── 4. DEFAULT DENY ────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
